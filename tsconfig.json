{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Workspace packages resolve to their sources, so typecheck, tests and scripts need no build.
    // Must mirror each package.json "exports" map; tests/packages.test.ts checks that.
    "paths": {
      "@pdfdeck/model": ["./packages/model/src/index.ts"],
      "@pdfdeck/puppeteer": ["./packages/puppeteer/src/index.ts"],
      "@pdfdeck/pptxgenjs": ["./packages/pptxgenjs/src/index.ts"],
      "@pdfdeck/pptxgenjs/html": ["./packages/pptxgenjs/src/html.ts"],
      "@pdfdeck/wasm": ["./packages/wasm/src/browser.ts"],
      "@pdfdeck/react": ["./packages/react/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "crates"]
}

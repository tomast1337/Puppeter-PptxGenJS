{
  "name": "@pdflapas/puppeteer",
  "version": "0.2.0",
  "description": "Puppeteer renderer for PdfLapas: prints the HTML presentation document to PDF in Chromium",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomast1337/Puppeter-PptxGenJS.git",
    "directory": "packages/puppeteer"
  },
  "bugs": {
    "url": "https://github.com/tomast1337/Puppeter-PptxGenJS/issues"
  },
  "homepage": "https://github.com/tomast1337/Puppeter-PptxGenJS#readme",
  "keywords": [
    "pdf",
    "presentation",
    "puppeteer"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "bun ../../scripts/build.ts"
  },
  "dependencies": {
    "@pdflapas/model": "workspace:*",
    "parse5": "7.3.0",
    "puppeteer": "^25.18.1"
  }
}

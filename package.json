{
  "name": "puppeter-pptxgenjs",
  "version": "0.1.0",
  "main": "./dist/exports.js",
  "module": "./dist/exports.js",
  "types": "./dist/exports.d.ts",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/exports.d.ts",
      "import": "./dist/exports.js",
      "default": "./dist/exports.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "prepack": "bun run build",
    "test:package": "bun run scripts/test-package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:visual": "bun run tests/visual/compare.ts",
    "test:visual:gallery": "VISUAL_GALLERY_DIR=visual-comparison bun run tests/visual/compare.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest",
    "@types/jsdom": "^21.1.7",
    "pptxgenjs": "4.0.1",
    "typescript": "^5"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "jsdom": "^26.1.0",
    "puppeteer": "^24.15.0"
  }
}

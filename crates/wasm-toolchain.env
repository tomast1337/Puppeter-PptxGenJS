# Pinned WASM build tools, read by packages/wasm/build-wasm.sh (local, Docker and CI builds alike).
# The compiler is pinned in rust-toolchain.toml. Prebuilt linux-x86_64 binaries are downloaded
# from each project's GitHub releases and checked against these sha256 sums.
WASM_PACK_VERSION=0.13.1
WASM_PACK_SHA256=c539d91ccab2591a7e975bcf82c82e1911b03335c80aa83d67ad25ed2ad06539
# Must equal the wasm-bindgen crate version in crates/Cargo.lock (build-wasm.sh checks it).
WASM_BINDGEN_VERSION=0.2.130
WASM_BINDGEN_SHA256=9687f3bb551b9f66f37ed32a40d7913a00f7962db653054e56857bc306c3227f
# Binaryen 117 is what wasm-pack 0.13.1 downloads itself; pinned here so a host wasm-opt cannot leak in.
BINARYEN_VERSION=117
BINARYEN_SHA256=3dc677006555b355ea2da5e82602065a161d5e83eaefd3f759afa00b96e83212
# The fallback image when the host lacks rustc 1.95.0 (official image, pinned by digest).
RUST_IMAGE=rust:1.95.0-trixie@sha256:f49565f188ee00bc2a18dd418183f2c5f23ef7d6e691890517ed341a598f67c3
